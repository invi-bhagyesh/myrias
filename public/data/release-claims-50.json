[{"id":"C17395","source_id":"S580","species_id":"mandarin-fish","locator":{"page":1},"quote":"#$$$ 年和#$$! 年各试验点均采用生态法和松枝浸泡法防治锚头鳋病，取得很好的预防效果。","quote_lang":"zh","statement":"后续年份各试验点采用生态法和松枝浸泡法均取得了很好的锚头鳋病预防效果。","statement_lang":"zh","text_zh":"后续年份各试验点采用生态法和松枝浸泡法均取得了很好的锚头鳋病预防效果。","text_en":null,"kind":"measured","population":{"species":"胭脂鱼","life_stage":null,"system":"池塘养殖"},"intervention":"Pine branch soaking","intervention_record":"松枝浸泡","comparator":null,"outcome":"病害预防","direction":null,"magnitude":null,"polarity":"supportive","welfare_link":"direct","verification":"supported","audit":"not_audited"},{"id":"C17396","source_id":"S580","species_id":"mandarin-fish","locator":{"page":1},"quote":"胭脂鱼的起捕率很高，拉网时不跳跃。","quote_lang":"zh","statement":"胭脂鱼在拉网时不跳跃，因此起捕率很高。","statement_lang":"zh","text_zh":"胭脂鱼在拉网时不跳跃，因此起捕率很高。","text_en":null,"kind":"measured","population":{"species":"胭脂鱼","life_stage":null,"system":"池塘养殖"},"intervention":"Seine net catching","intervention_record":"拉网捕捞","comparator":null,"outcome":"应激反应与捕捞效率","direction":null,"magnitude":null,"polarity":"descriptive","welfare_link":"direct","verification":"partial","audit":"not_audited"},{"id":"C17397","source_id":"S580","species_id":"mandarin-fish","locator":{"page":1},"quote":"河蟹、鳜鱼种苗要求同一批次，各自规格整齐一致，无病无伤。","quote_lang":"zh","statement":"放养的河蟹和鳜鱼种苗需来自同一批次，规格整齐且无病无伤。","statement_lang":"zh","text_zh":"放养的河蟹和鳜鱼种苗需来自同一批次，规格整齐且无病无伤。","text_en":null,"kind":"claimed","population":{"species":"河蟹, 鳜鱼","life_stage":null,"system":"稻田养殖"},"intervention":"Seedling selection","intervention_record":"苗种筛选","comparator":null,"outcome":"初始健康状况","direction":null,"magnitude":null,"polarity":"supportive","welfare_link":"direct","verification":"supported","audit":"not_audited"},{"id":"C17398","source_id":"S580","species_id":"mandarin-fish","locator":{"page":1},"quote":"水稻预防病害使用高效低毒农药，河蟹病防治，不使用有机磷及其他对鳜鱼","quote_lang":"zh","statement":"在水稻病害防治中使用高效低毒农药，并在河蟹病防治中避免使用对鳜鱼有害的有机磷等药物。","statement_lang":"zh","text_zh":"在水稻病害防治中使用高效低毒农药，并在河蟹病防治中避免使用对鳜鱼有害的有机磷等药物。","text_en":null,"kind":"claimed","population":{"species":"河蟹, 鳜鱼","life_stage":null,"system":"稻田养殖"},"intervention":"Restricting pesticide choice","intervention_record":"农药选择限制","comparator":null,"outcome":"毒性暴露风险","direction":null,"magnitude":null,"polarity":"supportive","welfare_link":"direct","verification":"supported","audit":"not_audited"},{"id":"C17399","source_id":"S582","species_id":"mandarin-fish","locator":{"page":1},"quote":"饲料蛋白质、脂肪和碳水化合物水平过高对不同规格草鱼摄食和生长都有抑制效果。","quote_lang":"zh","statement":"饲料中蛋白质、脂肪和碳水化合物水平过高会抑制不同规格草鱼的摄食和生长。","statement_lang":"zh","text_zh":"饲料中蛋白质、脂肪和碳水化合物水平过高会抑制不同规格草鱼的摄食和生长。","text_en":null,"kind":"measured","population":{"species":"草鱼","life_stage":null,"system":null},"intervention":"High-nutrient feed","intervention_record":"高含量营养素饲料","comparator":null,"outcome":"摄食与生长","direction":null,"magnitude":null,"polarity":"counterevidence","welfare_link":"direct","verification":"supported","audit":"not_audited"},{"id":"C17400","source_id":"S582","species_id":"mandarin-fish","locator":{"page":1},"quote":"饲料中添加植酸和单宁降低摄食和饲料利用，进而抑制生长。","quote_lang":"zh","statement":"在饲料中添加植酸和单宁会降低草鱼的摄食量和饲料利用率，从而抑制其生长。","statement_lang":"zh","text_zh":"在饲料中添加植酸和单宁会降低草鱼的摄食量和饲料利用率，从而抑制其生长。","text_en":null,"kind":"measured","population":{"species":"草鱼","life_stage":null,"system":null},"intervention":"Adding phytic acid and tannin","intervention_record":"添加植酸和单宁","comparator":null,"outcome":"摄食与生长","direction":null,"magnitude":null,"polarity":"counterevidence","welfare_link":"direct","verification":"partial","audit":"not_audited"},{"id":"C17401","source_id":"S582","species_id":"mandarin-fish","locator":{"page":1},"quote":"芥酸在一定浓度范围内对草鱼生长、摄食和免疫方面有促进作用，可以作为保健剂进行研究；其抗营养作用与其添加浓度有关，只有添加浓度到一定值时才表现为抗营养作用。","quote_lang":"zh","statement":"芥酸在特定浓度范围内促进草鱼生长、摄食和免疫，但超过一定浓度后表现出抗营养作用。","statement_lang":"zh","text_zh":"芥酸在特定浓度范围内促进草鱼生长、摄食和免疫，但超过一定浓度后表现出抗营养作用。","text_en":null,"kind":"measured","population":{"species":"草鱼","life_stage":null,"system":null},"intervention":"Adding erucic acid","intervention_record":"添加芥酸","comparator":null,"outcome":"生长、摄食与免疫","direction":null,"magnitude":null,"polarity":"mixed","limitations":"存在最佳浓度范围，过量则有害","counterevidence":"高浓度下表现为抗营养作用","welfare_link":"direct","verification":"supported","audit":"not_audited"},{"id":"C17402","source_id":"S582","species_id":"mandarin-fish","locator":{"page":1},"quote":"血清总蛋白、血清尿素氮、肝脏天冬氨酸转氨酶活性、肝脏谷氨酸脱氢酶活性和肌肉腺苷酸脱氨酶活性随蛋白水平的升高显著增加(P<0.05)，而肝脏丙氨酸转氨酶活性先增加后稳定，这表明高蛋白质组有较多的蛋白质用于提供能量而非生长。","quote_lang":"zh","statement":"高蛋白饲料导致多项代谢指标显著变化，表明过多的蛋白质被用于供能而非促进生长。","statement_lang":"zh","text_zh":"高蛋白饲料导致多项代谢指标显著变化，表明过多的蛋白质被用于供能而非促进生长。","text_en":null,"kind":"inferred","population":{"species":"草鱼","life_stage":null,"system":null},"intervention":"High-protein feed","intervention_record":"高蛋白饲料","comparator":null,"outcome":"氮代谢与能量利用","direction":null,"magnitude":null,"polarity":"counterevidence","welfare_link":"proxy","verification":"supported","audit":"not_audited"},{"id":"C17403","source_id":"S582","species_id":"mandarin-fish","locator":{"page":1},"quote":"饲料中添加中性植酸酶提高了鱼体、骨和血清中矿物质含量，同时也提高了多种矿物质的表观消化率。","quote_lang":"zh","statement":"饲料中添加中性植酸酶提高了草鱼鱼体、骨骼和血清中的矿物质含量及多种矿物质的表观消化率。","statement_lang":"zh","text_zh":"饲料中添加中性植酸酶提高了草鱼鱼体、骨骼和血清中的矿物质含量及多种矿物质的表观消化率。","text_en":null,"kind":"measured","population":{"species":"草鱼","life_stage":null,"system":null},"intervention":"Adding neutral phytase","intervention_record":"添加中性植酸酶","comparator":null,"outcome":"矿物质吸收","direction":null,"magnitude":null,"polarity":"supportive","welfare_link":"proxy","verification":"partial","audit":"not_audited"},{"id":"C17404","source_id":"S582","species_id":"mandarin-fish","locator":{"page":1},"quote":"草鱼摄食添加单宁的饲料后，血清总蛋白和白蛋白含量下降，对肝脏的几个免疫指标也有影响；高浓度单宁组，草鱼肝脏组织出现不同程度的损伤。","quote_lang":"zh","statement":"摄食添加单宁的饲料导致草鱼血清蛋白下降并影响免疫指标，高浓度单宁还会造成肝脏组织损伤。","statement_lang":"zh","text_zh":"摄食添加单宁的饲料导致草鱼血清蛋白下降并影响免疫指标，高浓度单宁还会造成肝脏组织损伤。","text_en":null,"kind":"measured","population":{"species":"草鱼","life_stage":null,"system":null},"intervention":"Adding tannin","intervention_record":"添加单宁","comparator":null,"outcome":"免疫与肝脏健康","direction":null,"magnitude":null,"polarity":"counterevidence","limitations":"高浓度下毒性明显","welfare_link":"direct","verification":"supported","audit":"not_audited"},{"id":"C17405","source_id":"S582","species_id":"mandarin-fish","locator":{"page":1},"quote":"在低浓度下，芥酸对于SOD 和GPX 活力的影响是促进作用，而超过该浓度后，SOD 和GPX 活力出现下降趋势。","quote_lang":"zh","statement":"低浓度芥酸促进草鱼SOD和GPX活力，但超过一定浓度后这些抗氧化酶活力呈下降趋势。","statement_lang":"zh","text_zh":"低浓度芥酸促进草鱼SOD和GPX活力，但超过一定浓度后这些抗氧化酶活力呈下降趋势。","text_en":null,"kind":"measured","population":{"species":"草鱼","life_stage":null,"system":null},"intervention":"Adding erucic acid","intervention_record":"添加芥酸","comparator":null,"outcome":"抗氧化能力","direction":null,"magnitude":null,"polarity":"mixed","limitations":"存在剂量依赖性","counterevidence":"高浓度抑制抗氧化酶活力","welfare_link":"proxy","verification":"supported","audit":"not_audited"},{"id":"C17406","source_id":"S582","species_id":"mandarin-fish","locator":{"page":1},"quote":"通过切片组织观察，低浓度芥酸对草鱼肝脏的毒害作用不明显，而当浓度显著增大时，草鱼肝脏组织开始出现损伤。","quote_lang":"zh","statement":"低浓度芥酸对草鱼肝脏无明显毒害，但浓度显著增大时会导致肝脏组织损伤。","statement_lang":"zh","text_zh":"低浓度芥酸对草鱼肝脏无明显毒害，但浓度显著增大时会导致肝脏组织损伤。","text_en":null,"kind":"measured","population":{"species":"草鱼","life_stage":null,"system":null},"intervention":"Adding erucic acid","intervention_record":"添加芥酸","comparator":null,"outcome":"肝脏健康","direction":null,"magnitude":null,"polarity":"mixed","limitations":"高浓度有毒性","welfare_link":"direct","verification":"supported","audit":"not_audited"}]
